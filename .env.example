# Copy to .env and fill in. Never commit .env.
# Use .env, not .env.local: Next.js reads both but the Prisma CLI only reads
# .env, so migrations would not see DATABASE_URL / DIRECT_URL otherwise.

# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server only, never prefix with NEXT_PUBLIC_. Can live in
# Supabase Vault instead of here; see "Secrets" in the README.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres (Settings → Database)
# DATABASE_URL must be the transaction POOLER url on Vercel (port 6543) so serverless functions don't exhaust connections.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL is the direct connection (port 5432) — used only by prisma migrate.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Anthropic — powers the intake / strategy / suggestion / brief-draft agents.
# Can live in Supabase Vault instead of here. Use a WORKSPACE-scoped key; an
# organisation-level key also needs ANTHROPIC_WORKSPACE_ID.
ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=
# Optional model overrides (defaults in lib/ai/models.ts)
# AI_MODEL_DEEP=claude-opus-4-8
# AI_MODEL_FAST=claude-sonnet-4-6

# Background AI jobs (lib/ai/jobs.ts). Any long random string.
# AI_JOB_SECRET protects /api/ai/run (server-to-server). It can live in
# Supabase Vault instead of here — see "Secrets" in the README.
# CRON_SECRET protects /api/ai/sweep and must stay in the environment: Vercel
# reads it to sign cron requests, so Vault is not an option for it.
AI_JOB_SECRET=
CRON_SECRET=
# Optional: public origin used for server-to-server calls (defaults to the request host)
# NEXT_PUBLIC_SITE_URL=https://portal.example.com
